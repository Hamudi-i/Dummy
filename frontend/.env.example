# ─────────────────────────────────────────────────────────────
# Co-Lab Frontend Environment Variables
# ─────────────────────────────────────────────────────────────

# Backend API URL
# Local: http://localhost:5000
# Production (Render): https://your-backend-name.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# WebSockets URL for real-time collaboration (Optional: automatically derived from NEXT_PUBLIC_API_URL if omitted)
# Local: ws://localhost:5000/collaboration
# Production (Render): wss://your-backend-name.onrender.com/collaboration
NEXT_PUBLIC_WS_URL=ws://localhost:5000/collaboration

